// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



model User {
  id String @id @default(uuid())
  name String
  email String @unique
  password String 
  role Role

  Projects Project[] @relation("ManagerProjects") 
  createdBugs Bug[] @relation("BugCreator")
  assignedBugs Bug[] @relation("BugDeveloper")
  projectUsers ProjectUser[]
  sentInvitations Invitation[] @relation("SentInvitations")
  receivedInvitations Invitation[] @relation("ReceivedInvitations")
  performedActivities Activity[] @relation("PerformedActivities")
  assignedActivities Activity[]  @relation("AssignedActivities")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id String @id @default(uuid())
  name String @unique 
  description String?
  deadline DateTime?

  managerID String
  manager User @relation("ManagerProjects", fields: [managerID], references: [id])

  bugs Bug[] 
  projectUsers ProjectUser[]
  invitations Invitation[]

  deletedAt DateTime? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt   
}

model Bug{
  id String @id @default(uuid())
  title String
  deadline DateTime?
  description String?
  image String?
  type BugType
  status BugStatus
  deletedAt DateTime?

  creatorId String
  assignedBy User @relation("BugCreator", fields: [creatorId], references: [id])

  projectId String
  project Project @relation(fields: [projectId], references: [id])
  
  developerId String?
  assignedTo User? @relation("BugDeveloper", fields: [developerId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt   
  @@unique([title, projectId]) 

}

model ProjectUser{
  id String @id @default(uuid())
  userId String
  projectId String
  acceptInvite Boolean @default(false)
  user User @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  @@unique([userId,projectId])
}

model Invitation {
  id String @id @default(uuid())
  inviteToken String? @unique
  inviteExpiry DateTime?
  acceptInvite Boolean @default(false)

  invitedById String
  invitedBy User @relation("SentInvitations", fields: [invitedById], references: [id])

  projectId String
  project Project @relation(fields: [projectId], references: [id])

  invitedUserId String?
  invitedUser User? @relation("ReceivedInvitations", fields: [invitedUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Activity {
  id String @id @default(uuid())
  action String

  entityType ActivityEntityType 
  entityId String
  entityTitle String?

  changedFields String[]
  oldValues String[]
  newValues String[]

  actorUserId String
  actorUser User @relation("PerformedActivities", fields: [actorUserId], references: [id])

  assignedToUserId String?
  assignedToUser User? @relation("AssignedActivities", fields: [assignedToUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  
}

enum Role{
  MANAGER
  DEVELOPER
  QA
}
enum BugType {
  FEATURE
  BUG
}

enum BugStatus{
  NEW 
  STARTED
  RESOLVED
  COMPLETED
}
enum ActivityEntityType{
  BUG
  PROJECT
}

